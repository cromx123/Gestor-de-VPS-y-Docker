# Contraseña para entrar al panel. Obligatoria (usa una larga: el panel controla Docker).
ADMIN_PASSWORD=

# Clave para firmar la sesión. Si falta, se genera una al azar y las sesiones se pierden al reiniciar.
SESSION_SECRET=

# Horas que dura la sesión.
SESSION_HOURS=12

# Contenedores que no se pueden DETENER desde la web (sí reiniciar), separados por coma.
PROTECTED_CONTAINERS=proxy_principal,web_gestor
